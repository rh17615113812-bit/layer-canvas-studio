{
  "name": "layer-canvas-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "api": "node server.mjs",
    "setup:ocr": "node scripts/setup-ocr.mjs",
    "test:ocr": "node --test tests/local-ocr.test.mjs",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/coordinates.test.ts tests/regressions.test.ts tests/vision-boxes.test.mjs tests/tencent-ocr.test.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^24.0.0",
    "ag-psd": "^28.0.0",
    "fflate": "^0.8.2",
    "konva": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.0.0",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
