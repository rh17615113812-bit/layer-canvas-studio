# 仅放在本机 .env.local，切勿提交或放到前端代码中。
ARK_API_KEY=你的火山方舟_API_Key
# 如控制台给出的模型 ID 不同，可在此覆盖。
ARK_SEEDREAM_MODEL=doubao-seedream-5.0-pro
ARK_VISION_MODEL=doubao-seed-2-0-lite-260215

# 本地拆分：也可在界面中选择“Save (API Format)”工作流 JSON。
COMFYUI_URL=http://127.0.0.1:8188
# 可选：相对于项目目录的 API 工作流文件。
COMFYUI_WORKFLOW_FILE=

# RunningHub 工作流拆分：API Key 仅由本机服务端读取，切勿放进前端代码或提交到 Git。
RUNNINGHUB_API_KEY=
# 可选：界面也可按工作流分别填写。此示例来自 Qwen2.1 抠图工作流 API 文档。
RUNNINGHUB_WORKFLOW_ID=2101886414299426818
